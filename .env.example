# ── AiroBase (shared Casa Libre DB — same as buyer portal & super admin) ──
AIROBASE_URL=https://<your-db>.db.airosofts.com
AIROBASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin session ──
# HMAC key that signs the admin session cookie. Set a long random string in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# Seeded admin login. Defaults are baked into lib/adminAuth.js so the portal
# works out of the box; override here to change the admin account.
#   ADMIN_EMAIL=omar@airosofts.com
#   ADMIN_PASSWORD_HASH=<bcrypt hash of the password>
# ADMIN_EMAIL=omar@airosofts.com
# ADMIN_PASSWORD_HASH=

# ── PostHog (buyer-behaviour analytics — read via the HogQL query API) ──
# Leave unset to render the "PostHog not connected" state.
#   POSTHOG_PERSONAL_API_KEY  phx_… personal key, scope: query:read
#   POSTHOG_PROJECT_ID        numeric project id, e.g. 530284
#   POSTHOG_HOST              https://us.posthog.com  (query host — no "i.")
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
